APP_NAME="postd.uk"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/London
APP_URL=https://api.postd.uk

APP_LOCALE=en_GB
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postduk
DB_USERNAME=postduk
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.postd.uk

BROADCAST_CONNECTION=redis
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=postduk_

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# Storage — DigitalOcean Spaces
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ams3
AWS_BUCKET=postduk-media
AWS_ENDPOINT=https://ams3.digitaloceanspaces.com
AWS_USE_PATH_STYLE_ENDPOINT=false
FILESYSTEM_DISK=s3

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=gbp
CASHIER_CURRENCY_LOCALE=en_GB
CASHIER_LOGGER=stack

# OpenAI
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_REQUEST_TIMEOUT=60

# Social Platforms — Facebook / Instagram
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://api.postd.uk/api/auth/social/facebook/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://api.postd.uk/api/auth/social/instagram/callback

# Social Platforms — X (Twitter)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=https://api.postd.uk/api/auth/social/twitter/callback

# Social Platforms — LinkedIn (Company Pages only)
# Must be a developer app whose ONLY product is the Community Management API.
# LinkedIn forbids pairing that product with Sign In with LinkedIn or Share on
# LinkedIn, so this app has no profile scope and cannot post to personal profiles.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://api.postd.uk/api/auth/social/linkedin/callback
# Versioned REST header. Each version retires roughly a year after release and an
# unsupported value fails every /rest/* call — check LinkedIn's docs before setting.
LINKEDIN_API_VERSION=202506

# Social Platforms — TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://api.postd.uk/api/auth/social/tiktok/callback

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.postd.uk/api/auth/social/google_business_profile/callback
GOOGLE_PLACES_API_KEY=

# Creatomate (TikTok video generation)
CREATOMATE_API_KEY=

# NewsAPI (local news hooks)
NEWS_API_KEY=
NEWS_API_COUNTRY=gb

# Mail
# Transactional email via SMTP2GO's HTTP API.
# SMTP2GO_API_KEY is the "api-..." key from Sending > API Keys. It is NOT an SMTP
# password — SMTP auth needs a separate credential from Sending > SMTP Users.
MAIL_MAILER=smtp2go
SMTP2GO_API_KEY=
MAIL_FROM_ADDRESS=hello@postd.uk
MAIL_FROM_NAME="postd.uk"

# Only needed if you switch MAIL_MAILER back to smtp
MAIL_HOST=mail.smtp2go.com
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# Horizon
HORIZON_SECRET=

# Admin
ADMIN_EMAIL=admin@dijitul.co.uk

# Meilisearch (Scout)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# CORS — allow SPA origin
SANCTUM_STATEFUL_DOMAINS=postd.uk,www.postd.uk,localhost:5173

# Rate limiting
THROTTLE_API=60
THROTTLE_AUTH=5
